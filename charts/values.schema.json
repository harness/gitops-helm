{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "appProject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "projectMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "appProject": {
            "type": "string",
            "minLength": 1
          },
          "orgId": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "autoCreateServiceEnv": {
            "type": "boolean"
          },
          "adoptMappingId": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "appProject"
        ]
      }
    },
    "harnessAgent": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
